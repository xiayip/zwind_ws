<?xml version="1.0"?>
<package format="3">
  <name>zephyr_surround_vision</name>
  <version>0.1.0</version>
  <description>Calibrated fisheye panorama rendering as a composable C++ ROS 2 node.</description>
  <maintainer email="maintainers@example.com">Zephyr contributors</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>rcl_interfaces</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>image_transport</depend>
  <depend>libopencv-dev</depend>
  <depend>yaml-cpp</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>zephyr_gmsl_camera</exec_depend>
  <exec_depend>compressed_image_transport</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
