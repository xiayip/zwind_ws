[Unit]
Description=Register Zephyr robot with Tailscale
Wants=network-online.target tailscaled.service
After=network-online.target tailscaled.service
ConditionPathExists=/etc/zephyr/robot.env

[Service]
Type=oneshot
ExecStart=/etc/systemd/zephyr_tailscale_join.sh
RemainAfterExit=yes
Restart=on-failure
RestartSec=15
User=root

[Install]
WantedBy=multi-user.target
